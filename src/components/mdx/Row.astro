---
interface Props {
    cols?: string;
    gap?: string;
    align?: string;
}

const { cols = "1fr 1fr", gap = "1.5rem", align = "start" } = Astro.props;
---

<div
    class="mdx-row"
    style={`grid-template-columns: ${cols}; gap: ${gap}; align-items: ${align};`}
>
    <slot />
</div>

<style>
    .mdx-row {
        display: grid;
        width: 100%;
        margin: 1.5rem 0;
    }

    @media (max-width: 768px) {
        .mdx-row {
            grid-template-columns: 1fr !important;
        }
    }
</style>
