---
import { getCollection, render } from "astro:content";
import "../styles/global.css";
import ProfileImage from "./profileimage.astro";

import { getLinkHref } from "../utils/paths";
const profileUrl = getLinkHref("violahead.JPG");

// Get the CV content
const cvEntries = await getCollection("cv");
const cv = cvEntries[0]; // Get the first (and only) CV entry

if (!cv) {
    throw new Error("CV not found");
}

const { Content } = await render(cv);
---

<section>
    <div class="text-left">
        <p class="font-serif italic normal-case hover:not-italic text-sm">
            {cv.data.title}
        </p>
        <span> ⇣</span>
    </div>
</section>
<section class="flex flex-row">
    <div class="flex flex-col justify-top items-end pr-10 pt-1">
        <ProfileImage />
    </div>
    <div class="w-full">
        {
            cv.data.description && (
                <span class="text-sm font-mono not-italic">
                    {cv.data.description}
                </span>
            )
        }
        <div class="cv-container text-sm">
            <Content />
        </div>
    </div>
</section>
