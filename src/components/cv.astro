---
import { getCollection, render } from "astro:content";
import "../styles/global.css";
import ProfileImage from "./profileimage.astro";

import { getLinkHref } from "../utils/paths";
const profileUrl = getLinkHref("violahead.JPG");

// Get the CV content
const cvEntries = await getCollection("cv");
const cv = cvEntries[0]; // Get the first (and only) CV entry

if (!cv) {
    throw new Error("CV not found");
}

const { Content } = await render(cv);
---

<section class="mx-2 lg:mx-0">
    <div>
        <p class="font-serif italic hover:not-italic text-sm">
            {cv.data.title}
        </p>
        <span> ⇣</span>
    </div>
</section>
<section class="flex lg:flex-row flex-col">
    <div
        class="flex flex-col items-start lg:items-end mx-2 mb-2 lg:mx-0 pr-7 py-1"
    >
        <ProfileImage />
    </div>
    <div class="w-full">
        {
            cv.data.description && (
                <p class="text-sm font-mono not-italic mx-2 lg:mx-0">
                    {cv.data.description}
                </p>
            )
        }
        <div class="cv-container text-sm">
            <Content />
        </div>
    </div>
</section>
