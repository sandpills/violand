---
// originally card list
import { getAssetPath, getLinkHref } from "../utils/paths.ts";
import { remark } from "remark";
import remarkGfm from "remark-gfm";
import html from "remark-html";
import Box from "./box.astro";

interface Props {
    href?: string;
    title: string;
    body?: string;
    tags?: string[];
    date?: Date;
    image?: string;
}

const { href, title, body, tags, date, image } = Astro.props;

async function parseMarkdown(markdown: string): Promise<string> {
    if (!markdown) return "";
    const result = await remark().use(remarkGfm).use(html).process(markdown);
    let htmlContent = String(result);
    htmlContent = htmlContent.replace(
        /<a href="([^"]+)">([^<]+)<\/a>/g,
        '<a href="$1" class="card-body-link" target="_blank" rel="noopener noreferrer">$2</a>',
    );
    htmlContent = htmlContent.replace(/^<p>(.*)<\/p>$/s, "$1");
    return htmlContent;
}

const parsedBody = body ? await parseMarkdown(body) : "";
const imgSrc = image
    ? image.startsWith("/")
        ? getAssetPath(image)
        : image
    : undefined;
---

<!-- originally card lists -->
<li class="basis-100% lg:basis-75">
    <div class="card h-100 shadow-md">
        {
            imgSrc && (
                <img
                    src={imgSrc}
                    alt={title}
                    class="noisy-image w-full h-48 object-cover"
                />
            )
        }
        <div class="px-3 py-2">
            <h3>
                <a
                    href={getLinkHref(href || "")}
                    class="title"
                    target={href?.startsWith("http") ? "_blank" : undefined}
                    rel={href?.startsWith("http")
                        ? "noopener noreferrer"
                        : undefined}
                >
                    <span>{title}</span>
                </a>
            </h3>
            <div class="pb-2 pt-1 font-mono text-sm" set:html={parsedBody} />
            {
                tags && tags.length > 0 && (
                    <div class="inside-pill flex-wrap gap-y-1">
                        {tags.map((tag) => (
                            <Box>{tag}</Box>
                        ))}
                        {date && <Box>{date.getFullYear()}</Box>}
                    </div>
                )
            }
        </div>
    </div>
</li>
