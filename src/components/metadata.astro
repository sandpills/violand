---
import Violawhere from "./violawhere.astro";
import { metadata, getGitLastCommit } from "../data/metadata.ts";

import RecurseWebring from "./recursewebring.astro";

// Get git last commit time (when you last pushed)
const gitLastCommit = await getGitLastCommit();

// Format the git last commit date with full date and time
const formatGitDateTime = (dateString: string) => {
    const date = new Date(dateString);
    const dayString = date.toLocaleString("en-US", {
        timeZone: metadata.timezone,
        year: "2-digit",
        month: "2-digit",
        day: "2-digit",
    });
    const timeString = date.toLocaleTimeString("en-US", {
        timeZone: metadata.timezone,
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
    });
    return `${dayString} ${timeString}`;
};

const lastUpdated = formatGitDateTime(gitLastCommit);
---

<div class="metadata-container font-mono text-sm space-y-1">
    <!-- Current Whereabouts -->
    <div class="metadata-section">
        <h3 class="text-sm">Current Whereabouts</h3>
        <div class="text-sm font-mono">
            <Violawhere />
        </div>
    </div>

    <!-- Things on Mind -->
    <div class="metadata-section">
        <h3 class="text-sm">Things on my Mind</h3>
        <ul class="text-sm font-mono space-y-1">
            {metadata.things.map((thing) => <li>⇢ {thing}</li>)}
        </ul>
    </div>

    <!-- Site Last Updated -->
    <div class="metadata-section">
        <h3 class="text-sm mr-2">Last Updated</h3>
        <span class="metadata-time-display font-mono text-sm mr-1">
            {lastUpdated}
        </span>
        <span class="font-mono">
            <a
                href="https://github.com/sandpills/violand"
                class="hover:blur-xs text-sm">[source]</a
            >
        </span>
    </div>

    <div class="metadata-section">
        <RecurseWebring />
    </div>
</div>

<style>
    .metadata-section {
        padding-top: 0.25rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px dotted rgb(118, 118, 118);
    }

    .metadata-section:last-child {
        /* border-bottom: none; */
    }

    .metadata-section h3 {
        margin-bottom: 0.5rem;
    }

    .metadata-section p,
    .metadata-section ul {
        margin: 0;
        line-height: 1.1;
    }

    .metadata-section li {
        margin-bottom: 0.25rem;
    }

    /* .metadata-time-display {
        color: rgb(118, 118, 118);
    } */
</style>
