---
import Violawhere from "./violawhere.astro";
import { metadata, getGitLastCommit } from "../data/metadata.ts";

import RecurseWebring from "./recursewebring.astro";
import Aboutrc from "./aboutrc.astro";

// Get git last commit time (when you last pushed)
const gitLastCommit = await getGitLastCommit();

// Format the git last commit date with full date and time
const formatGitDateTime = (dateString: string) => {
    const date = new Date(dateString);
    const dayString = date.toLocaleString("en-US", {
        timeZone: metadata.timezone,
        year: "2-digit",
        month: "2-digit",
        day: "2-digit",
    });
    const timeString = date.toLocaleTimeString("en-US", {
        timeZone: metadata.timezone,
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
    });
    return `${dayString} ${timeString}`;
};

const lastUpdated = formatGitDateTime(gitLastCommit);
---

<div class="metadata-container font-mono text-sm space-y-1">
    <!-- Current Whereabouts -->
    <div class="metadata-section">
        <h3>Current Whereabouts</h3>
        <div>
            <Violawhere />
        </div>
    </div>

    <!-- Things on Mind -->
    <div class="metadata-section">
        <h3>Things on my Mind</h3>
        <ul class="space-y-1" data-mind-list>
            {metadata.things.map((thing) => <li>⇢ {thing}</li>)}
        </ul>
    </div>

    <!-- Site Last Updated -->
    <div class="metadata-section">
        <h3 class="mr-2">Last Updated</h3>
        <span class="metadata-time-display mr-1">
            {lastUpdated}
        </span>
        <span>
            <a href="https://github.com/sandpills/violand" class="hover:blur-xs"
                >[source]</a
            >
        </span>
    </div>

    <!-- <div class="metadata-section">
        <Aboutrc />
        <RecurseWebring />
    </div> -->
</div>

<script>
    import { renderInline } from "../utils/minimd";

    const WORKER_URL = "https://guest.viola-9ee.workers.dev/now";

    function latestByTag(records: any[], tag: string) {
        return records
            .filter((r) => (r.fields?.Tag || "").toLowerCase() === tag)
            .sort(
                (a, b) =>
                    new Date(b.createdTime).getTime() -
                    new Date(a.createdTime).getTime(),
            );
    }

    async function syncLiveMetadata() {
        try {
            const res = await fetch(WORKER_URL);
            const { records = [] } = await res.json();

            // Location line: most recent entry that carries a city (ANY tag).
            const located = records
                .filter((r) => (r.fields?.City || "").trim())
                .sort(
                    (a, b) =>
                        new Date(b.createdTime).getTime() -
                        new Date(a.createdTime).getTime(),
                )[0];
            if (located) {
                const loc = document.querySelector(".location");
                if (loc) loc.textContent = located.fields.City;
            }

            // Status line: latest "status" entry's text.
            const st = latestByTag(records, "status")[0];
            if (st && st.fields.Text) {
                const status = document.querySelector(".status");
                if (status) status.textContent = st.fields.Text;
            }

            // Things on my Mind: latest 3 "mind" entries
            const mind = latestByTag(records, "mind").slice(0, 3);
            const ul = document.querySelector("[data-mind-list]");
            if (ul && mind.length) {
                ul.innerHTML = mind
                    .map(
                        (m) =>
                            `<li>⇢ ${renderInline(m.fields.Text || "")}</li>`,
                    )
                    .join("");
            }
        } catch (e) {
            // keep the build-time fallback from metadata.ts
        }
    }

    syncLiveMetadata();
</script>

<style>
    .metadata-section {
        padding-top: 0.25rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px dotted rgb(118, 118, 118);
    }

    .metadata-section:last-child {
        /* border-bottom: none; */
    }

    .metadata-section h3 {
        margin-bottom: 0.5rem;
    }

    .metadata-section p,
    .metadata-section ul {
        margin: 0;
        line-height: 1.1;
    }

    .metadata-section li {
        margin-bottom: 0.25rem;
    }

    /* .metadata-time-display {
        color: rgb(118, 118, 118);
    } */
</style>
