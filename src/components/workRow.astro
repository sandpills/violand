---
// a single work rendered as a list row
import { getAssetPath, getLinkHref } from "../utils/paths.ts";
import { remark } from "remark";
import remarkGfm from "remark-gfm";
import html from "remark-html";
import Box from "./box.astro";
import type { TypedLink } from "../utils/projectLinks.ts";

interface Props {
    href?: string;
    title: string;
    body?: string;
    tags?: string[];
    year?: number | null;
    image?: string;
    links?: TypedLink[];
}

const { href, title, body, tags, year, image, links } = Astro.props;

async function parseMarkdown(markdown: string): Promise<string> {
    if (!markdown) return "";
    const result = await remark().use(remarkGfm).use(html).process(markdown);
    let htmlContent = String(result);
    htmlContent = htmlContent.replace(
        /<a href="([^"]+)">([^<]+)<\/a>/g,
        '<a href="$1" class="card-body-link" target="_blank" rel="noopener noreferrer">$2</a>',
    );
    htmlContent = htmlContent.replace(/^<p>(.*)<\/p>$/s, "$1");
    return htmlContent;
}

const parsedBody = body ? await parseMarkdown(body) : "";
const imgSrc = image
    ? image.startsWith("/")
        ? getAssetPath(image)
        : image
    : undefined;
---

<li
    class="border-b border-dotted border-gray-400/40 min-w-0"
    data-tags={(tags ?? []).join(",")}
>
    <div class="card work-row p-2" data-preview={imgSrc} data-title={title}>
        {
            imgSrc ? (
                <img
                    src={imgSrc}
                    alt={title}
                    class="noisy-image work-thumb-sm"
                />
            ) : (
                <div />
            )
        }
        <div class="work-col flex flex-col gap-1 p-2">
            <a
                href={getLinkHref(href || "")}
                class="title min-w-0"
                target={href?.startsWith("http") ? "_blank" : undefined}
                rel={href?.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined}
            >
                <span>{title}</span>
            </a>
            <div class="font-mono text-sm">
                <p set:html={parsedBody} />
            </div>
            {
                links && links.length > 0 && (
                    <div class="card-links flex flex-wrap gap-1">
                        {links.map((l) => (
                            <a
                                href={l.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="pill card-go-link"
                            >
                                {l.type} ↗
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
        <div class="work-col flex flex-col gap-1 p-2">
            {
                tags && tags.length > 0 && (
                    <div class="inside-pill flex-wrap gap-y-1">
                        {tags.map((tag) => (
                            <Box>{tag}</Box>
                        ))}
                    </div>
                )
            }
        </div>
        <div class="work-col work-year font-mono text-sm italic opacity-70 p-2">
            {year}
        </div>
    </div>
</li>
