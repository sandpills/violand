---
import { metadata } from "../data/metadata.ts";
---

<div>
    <span class="location">{metadata.location}</span>
    <span class="violawhere-time-display"></span>
    <div class="status">{metadata.status}</div>
</div>

<script>
    import { metadata } from "../data/metadata";

    function updateTime() {
        const now = new Date();
        const timeString = now.toLocaleTimeString("en-US", {
            timeZone: metadata.timezone,
            hour: "2-digit",
            minute: "2-digit",
            hour12: false,
        });

        // time display within this component
        const timeElement = document.querySelector(".violawhere-time-display");
        if (timeElement) timeElement.textContent = timeString;
    }

    updateTime();
    setInterval(updateTime, 60000);
</script>
