---
import { getCollection, render } from "astro:content";
import "../../styles/global.css";
import "../../styles/reader.css";
import Nav from "../../components/nav.astro";
import ProjectNav from "../../layouts/sitemap.astro";
import Mouse from "../../scripts/Mouse.svelte";
import DarkModeToggle from "../../components/darkModeToggle.astro";
import DarkModeScript from "../../components/darkModeScript.astro";
import { getAssetPath, getLinkHref } from "../../utils/paths.ts";
import { getTypedLinks } from "../../utils/projectLinks.ts";
import { getEntryDate } from "../../utils/dates.ts";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    // a project gets its own page only when it has a writeup
    const filteredProjects = projects.filter((project) =>
        Boolean((project.body ?? "").trim()),
    );
    return filteredProjects.map((project) => {
        const fileName = (project.id.split("/").pop() ?? "").replace(
            /\.mdx?$/,
            "",
        );
        const cleanSlug = fileName.replace(/^\d+-/, ""); // remove number prefix chunk
        return {
            params: { slug: cleanSlug },
            props: { project },
        };
    });
}

// Get all projects w page link for navigation
const allProjects = await getCollection("projects");
const internalProjects = allProjects.filter((project) =>
    Boolean((project.body ?? "").trim()),
);
const sortedProjects = internalProjects.sort((a, b) => {
    const aMatch = a.id.match(/^(\d+)-/);
    const bMatch = b.id.match(/^(\d+)-/);
    if (aMatch && bMatch) {
        return parseInt(aMatch[1]) - parseInt(bMatch[1]);
    }
    return a.id.localeCompare(b.id);
});

const { project } = Astro.props;
if (!project) {
    throw new Error("Project not found");
}
const { Content } = await render(project);
const projectLinks = getTypedLinks(project.data);
const projectYear = getEntryDate(project.data).year;

// Find current project index and get previous/next
const currentProjectIndex = sortedProjects.findIndex(
    (p) => p.id === project.id,
);
const prevProject =
    currentProjectIndex > 0 ? sortedProjects[currentProjectIndex - 1] : null;
const nextProject =
    currentProjectIndex < sortedProjects.length - 1
        ? sortedProjects[currentProjectIndex + 1]
        : null;

// Helper function to get clean slug for navigation
const getProjectSlug = (project: any) => {
    const fileName = project.id
        .split("/")
        .pop()
        ?.replace(/\.mdx?$/, "");
    return fileName?.replace(/^\d+-/, "");
};
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href={getAssetPath("guy.png")} />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{project.data.title}</title>
        <meta name="author" content="viola he" />
    </head>
    <body class="reader">
        <Nav />
        <div class="reader-progress" id="reader-progress"></div>

        <article class="reader-page">
            <header class="reader-head">
                <h1 class="reader-title">{project.data.title}</h1>
                <p class="reader-meta">
                    <span class="reader-meta-facts">
                        {
                            project.data.tags &&
                                project.data.tags.length > 0 && (
                                    <span>{project.data.tags.join(", ")}</span>
                                )
                        }
                        {projectYear && <span>{projectYear}</span>}
                    </span>
                    {
                        projectLinks.length > 0 && (
                            <span class="reader-meta-links">
                                {projectLinks.map((l) => (
                                    <a
                                        href={l.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="pill reader-meta-link"
                                    >
                                        {l.type} ↗
                                    </a>
                                ))}
                            </span>
                        )
                    }
                </p>
            </header>
            <hr class="reader-rule" />

            {
                project.data.heroImage && (
                    <figure class="reader-frontispiece">
                        <img
                            src={
                                project.data.heroImage?.startsWith("/")
                                    ? getAssetPath(project.data.heroImage)
                                    : project.data.heroImage
                            }
                            alt={project.data.title}
                            loading="lazy"
                        />
                    </figure>
                )
            }

            <div class="markdown-content">
                <Content />
            </div>

            <nav class="reader-pager">
                {
                    prevProject ? (
                        <a
                            class="pager-prev"
                            href={getLinkHref(
                                `/projects/${getProjectSlug(prevProject)}/`,
                            )}
                        >
                            <span>←</span>
                            <span>{prevProject.data.title}</span>
                        </a>
                    ) : (
                        <span class="pager-empty">⇤ start</span>
                    )
                }
                {
                    nextProject ? (
                        <a
                            class="pager-next"
                            href={getLinkHref(
                                `/projects/${getProjectSlug(nextProject)}/`,
                            )}
                        >
                            <span>{nextProject.data.title}</span>
                            <span>→</span>
                        </a>
                    ) : (
                        <span class="pager-empty pager-next">end ⇥</span>
                    )
                }
            </nav>
        </article>

        <aside class="reader-toc">
            <ProjectNav />
        </aside>

        <div class="fixed right-0 top-1">
            <DarkModeToggle />
            <DarkModeScript />
        </div>
        <Mouse client:load />

        <script>
            function initReader() {
                const bar = document.getElementById("reader-progress");
                if (!bar) return;
                const update = () => {
                    const max =
                        document.documentElement.scrollHeight -
                        window.innerHeight;
                    const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
                    bar.style.width = pct + "%";
                };
                update();
                window.addEventListener("scroll", update, { passive: true });
                window.addEventListener("resize", update);
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initReader);
            } else {
                initReader();
            }
            document.addEventListener("astro:after-swap", initReader);
        </script>
    </body>
</html>
