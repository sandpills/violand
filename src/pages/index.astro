			</section>
			<section class="main-container">
				<div id="left-outline">
					<About />
					<div class="projects">
						<Projects />
						<section id="more" class="py-4">
							<Box> ⇣ more </Box>
						</section>
						<section class="hide mb-10" id="rc-section">
