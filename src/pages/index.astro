---
import About from "../components/about.astro";
import Works from "../layouts/works.astro";
import Nav from "../components/nav.astro";
import { getAssetPath, getLinkHref } from "../utils/paths.ts";

import Metadata from "../components/metadata.astro";
import LowerRight from "../layouts/lowerright.astro";
import GadgetParts from "../layouts/gadgetparts.astro";
import GuestbookPeek from "../scripts/guestbookPeek.svelte";

import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link
			rel="icon"
			type="image/svg+xml"
			href={getAssetPath("blueguy.png")}
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<script
			src="https://raw.githack.com/Qwuke/recurse-ring/main/static/ring.js"
			type="text/javascript"></script>
		<title>✧˚.⋆ ⊹ ♡ !! ✦</title>
		<meta name="description" content="你好欢迎来我家" />
		<meta name="author" content="viola he" />
	</head>
	<body>
		<Nav />
		<div class="flex flex-col lg:flex-row">
			<section class="main-container-right">
				<div id="right-outline" class="flex flex-col">
					<div class="mt-4 lg:mt-0">
						<Metadata />
					</div>
					<LowerRight />
					<div class="mt-4">
						<div class="flex flex-row gap-4">
							<a
								href={getLinkHref("/guestbook/")}
								class="gb-side-title">guestbook →</a
							>
							<!-- <a
								href={getLinkHref("/guestbook/")}
								class="pill self-start"
								aria-label="sign my guestbook"
							>
								sign
							</a> -->
						</div>
						<GuestbookPeek
							client:load
							guestbookHref={getLinkHref("/guestbook/")}
						/>
					</div>
				</div>
			</section>
			<section class="main-container">
				<div id="left-outline" class="pl-2">
					<About />
					<div class="projects">
						<Works />
					</div>
					<marquee
						behavior="scroll"
						scrollamount="5"
						direction="down"
						class="fixed top-0 left-0 h-full pointer-events-none hidden lg:block"
					>
						<span
							class="text-sm font-mono text-bright dark:text-dark-bright text-shadow-lg"
						>
							<!-- <a
							href={getLinkHref("/")}
							class="text-bright hover:underline"
						> -->
							<pre>
	♡							  ✩  ┊                       ✮  				 ┊                  ✩⋆
						✩		┊    ┊      ★  ┊        |         ┊              ┊ 
		💿				  		┊    ✮         ⊹˚ ⁭      ⁭| ⁭ ⁭ ⁭ ⁭ ⁭ ⁭ ⁭  ⋆      ⊹       ✩ 
								┊                       ✮         ✧            |      ✧         ┊ 
								✩⋆                                            ✩⋆                ┊
	  	 	˚.⋆											          ✧                           ࣪⋆   
	┊						|			┊      ★  ┊                 ┊               ┊                       |
	┊						✧			✮         ⊹˚ ⁭        ⁭ ⁭ ⁭ ⁭ ⁭ ⁭ ⁭ | ⋆      ⊹      ♡                       |
	┊				|			┊                       ✮   ┊       ✧           |         ✩     ┊           ⊹˚
	✩				|			┊                           ✧                   ✩⋆          |   ✩⋆
					✧			┊    ┊                                                       ✧   
		┊						┊    ┊      ★  ┊   ┊    | ✩⋆      ┊              ┊  ˚               
		┊						┊    ♡         ⊹˚ ⁭ ✩⋆   ⁭| ⁭ ⁭ ⁭ ⁭ ⁭ ⁭ ⁭  ⋆      ⊹       ✩ 
		✧						★                       ✮   ┊     ✧                    ✧           💿
				★				 							✩⋆                                            ✩⋆              
