						scrollamount="5"
						direction="down"
						class="fixed top-0 left-0 h-full pointer-events-none hidden lg:block"
					>
						<span
							class="text-sm font-mono text-bright dark:text-dark-bright text-shadow-lg"
						>
							<!-- <a
							href={getLinkHref("/")}
							class="text-bright hover:underline"
						> -->
							<pre>
	♡							  ✩  ┊                       ✮  				 ┊                  ✩⋆
						✩		┊    ┊      ★  ┊        |         ┊              ┊ 
		💿				  		┊    ✮         ⊹˚ ⁭      ⁭| ⁭ ⁭ ⁭ ⁭ ⁭ ⁭ ⁭  ⋆      ⊹       ✩ 
								┊                       ✮         ✧            |      ✧         ┊ 
								✩⋆                                            ✩⋆                ┊
	  	 	˚.⋆											          ✧                           ࣪⋆   
	┊						|			┊      ★  ┊                 ┊               ┊                       |
	┊						✧			✮         ⊹˚ ⁭        ⁭ ⁭ ⁭ ⁭ ⁭ ⁭ ⁭ | ⋆      ⊹      ♡                       |
	┊				|			┊                       ✮   ┊       ✧           |         ✩     ┊           ⊹˚
	✩				|			┊                           ✧                   ✩⋆          |   ✩⋆
					✧			┊    ┊                                                       ✧   
		┊						┊    ┊      ★  ┊   ┊    | ✩⋆      ┊              ┊  ˚               
		┊						┊    ♡         ⊹˚ ⁭ ✩⋆   ⁭| ⁭ ⁭ ⁭ ⁭ ⁭ ⁭ ⁭  ⋆      ⊹       ✩ 
		✧						★                       ✮   ┊     ✧                    ✧           💿
				★				 							✩⋆                                            ✩⋆              
						</pre>
							<!-- </a> -->
						</span>
					</marquee>
				</div>
			</section>
		</div>
		<GadgetParts />
	</body>
</html>

<script>
	const dropdown = document.getElementById("more");
	const rcSection = document.getElementById("rc-section");
	// let toggleMore = false;

	dropdown?.addEventListener("click", async function () {
		if (dropdown && rcSection?.classList.contains("show")) {
			rcSection?.classList.add("hide");
			dropdown.textContent;
			rcSection?.classList.remove("show");
		} else if (dropdown) {
			rcSection?.classList.add("show");
			rcSection?.classList.remove("hide");
		}
	});
</script>

<style>
	.hide {
		display: none;
	}
	.show {
		display: block;
	}
</style>
