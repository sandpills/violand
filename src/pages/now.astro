---
import Nav from "../components/nav.astro";
import Mouse from "../scripts/Mouse.svelte";
import DarkModeToggle from "../components/darkModeToggle.astro";
import DarkModeScript from "../components/darkModeScript.astro";
import { getAssetPath } from "../utils/paths.ts";
import Metadata from "../components/metadata.astro";
import Now from "../scripts/now.svelte";

import "../styles/global.css";
import "../styles/cursor.css";
import "../styles/now.css";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link
            rel="icon"
            type="image/svg+xml"
            href={getAssetPath("blueguy.png")}
        />
        <title>now</title>
        <meta name="author" content="viola he" />
        <style>
            html,
            body,
            * {
                cursor: none !important;
            }
        </style>
    </head>

    <body>
        <div class="container">
            <Nav />
            <div class="fixed right-0 top-1 z-10">
                <DarkModeToggle />
            </div>

            <div class="now-page">
                <!-- <h1>now</h1> -->
                <p class="now-intro">you found viola's secret log!</p>
                <Now client:load />
            </div>

            <section class="main-container-right">
                <div id="right-outline" class="flex flex-col">
                    <div class="mt-4 lg:mt-0">
                        <Metadata />
                    </div>
                </div>
            </section>
        </div>
        <DarkModeScript />
        <Mouse client:load />
    </body>
</html>
