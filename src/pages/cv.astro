---
import Nav from "../components/nav.astro";
import DarkModeScript from "../components/darkModeScript.astro";
import { getAssetPath } from "../utils/paths.ts";
import Winamp from "../components/winamp.astro";
import Gadgets from "../components/gadgets.astro";
import { getLinkHref } from "../utils/paths.ts";
import LittleThings from "../components/littlethings.astro";
import SiteMap from "../components/sitemap.astro";
import CV from "../components/cv.astro";
import LowerRight from "../components/lowerright.astro";
import GadgetParts from "../components/gadgetparts.astro";
import Metadata from "../components/metadata.astro";
import Upcoming from "../components/upcoming.astro";

import "../styles/cv.css";
import "../styles/global.css";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link
            rel="icon"
            type="image/svg+xml"
            href={getAssetPath("blueguy.png")}
        />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>about viola</title>
        <style>
            html,
            body,
            * {
                cursor: none !important;
            }
        </style>
    </head>
    <body>
        <Nav />
        <div class="flex flex-col lg:flex-row">
            <section
                class="container overflow-hidden main-container-right relative lg:w-5/12 lg:fixed lg:right-0 lg:top-0 w-full mt-4 lg:mt-0"
            >
                <section id="right-outline" class="flex flex-col">
                    <div class="mt-4 lg:mt-0 mb-4">
                        <Metadata />
                    </div>
                    <div class="upcoming mt-4">
                        <!-- <Upcoming /> -->
                    </div>
                    <LowerRight />
                </section>
            </section>

            <section
                class="container main-container cv-container overflow-y-auto lg:fixed lg:left-0 lg:top-0 w-full mt-0 lg:mt-10"
            >
                <div>
                    <section class="font-mono mb-10">
                        <CV />
                    </section>
                    <br />
                </div>
            </section>
            <GadgetParts />
        </div>
    </body>
</html>
